# Supabase PostgreSQL Connection URI
# Ambil dari: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Pilih mode "Session" (Port 5432) atau Direct (Port 5432).
# Contoh:
# DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
